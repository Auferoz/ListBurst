---
interface Props {
    width?: string | number;
    height?: string | number;
    class?: string;
}
const { width = "18", height = "18", class: className = "" } = Astro.props;
---
<svg xmlns="http://www.w3.org/2000/svg" width={width} height={height} class={className} viewBox="0 0 24 24" fill="none">
  <circle cx="12" cy="12" r="11" fill="#333" stroke="#54A72F" stroke-width="2"/>
  <text x="12" y="17" text-anchor="middle" font-size="14" font-weight="bold" fill="#54A72F" font-family="sans-serif">OC</text>
</svg>
