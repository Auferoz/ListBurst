---
interface Props {
    width?: string | number;
    height?: string | number;
    class?: string;
}
const { width = "18", height = "18", class: className = "" } = Astro.props;
---
<svg xmlns="http://www.w3.org/2000/svg" width={width} height={height} class={className} viewBox="0 0 24 24" fill="none">
  <rect x="1" y="1" width="22" height="22" rx="4" fill="#1F1F1F" stroke="#FFF" stroke-width="1.5"/>
  <text x="12" y="17" text-anchor="middle" font-size="12" font-weight="bold" fill="#FFF" font-family="sans-serif">R</text>
</svg>
