---
import Layout from "../layouts/Layout.astro";
import { StreamingServiceAccounts } from "../data/SSAccounts.js";
import IconLock from "../components/Icons/IconLock.astro";
import IconEye from "../components/Icons/IconEye.astro";
import IconEyeOff from "../components/Icons/IconEyeOff.astro";
import IconCopy from "../components/Icons/IconCopy.astro";

const totalServices = StreamingServiceAccounts.length;
---

<Layout hideMenu>
	<main class="max-w-7xl mx-auto p-4 space-y-6 pb-24">

		<!-- ========== PIN LOCK SCREEN ========== -->
		<div id="pin-screen" class="fixed inset-0 z-50 flex items-center justify-center bg-zinc-900/98 backdrop-blur-sm">
			<div class="flex flex-col items-center gap-8 px-6 w-full max-w-sm">
				<!-- Lock icon -->
				<div class="flex items-center justify-center w-20 h-20 rounded-full bg-violet-500/10 border border-violet-500/20">
					<span class="text-violet-400">
						<IconLock width={36} height={36} />
					</span>
				</div>

				<!-- Title -->
				<div class="text-center space-y-2">
					<h1 class="text-2xl font-bold text-white tracking-tight">Streaming Services</h1>
					<p class="text-sm text-zinc-400">Introduce el PIN de 4 digitos para acceder</p>
				</div>

				<!-- PIN inputs -->
				<div class="flex gap-3" id="pin-container">
					<input type="password" inputmode="numeric" maxlength="1" class="pin-input w-14 h-16 text-center text-2xl font-bold bg-zinc-800/80 border border-zinc-700 rounded-xl text-white focus:border-violet-400 focus:outline-none focus:ring-1 focus:ring-violet-400/50 transition-all duration-200 caret-transparent" data-index="0" autocomplete="off" />
					<input type="password" inputmode="numeric" maxlength="1" class="pin-input w-14 h-16 text-center text-2xl font-bold bg-zinc-800/80 border border-zinc-700 rounded-xl text-white focus:border-violet-400 focus:outline-none focus:ring-1 focus:ring-violet-400/50 transition-all duration-200 caret-transparent" data-index="1" autocomplete="off" />
					<input type="password" inputmode="numeric" maxlength="1" class="pin-input w-14 h-16 text-center text-2xl font-bold bg-zinc-800/80 border border-zinc-700 rounded-xl text-white focus:border-violet-400 focus:outline-none focus:ring-1 focus:ring-violet-400/50 transition-all duration-200 caret-transparent" data-index="2" autocomplete="off" />
					<input type="password" inputmode="numeric" maxlength="1" class="pin-input w-14 h-16 text-center text-2xl font-bold bg-zinc-800/80 border border-zinc-700 rounded-xl text-white focus:border-violet-400 focus:outline-none focus:ring-1 focus:ring-violet-400/50 transition-all duration-200 caret-transparent" data-index="3" autocomplete="off" />
				</div>

				<!-- Error message -->
				<p id="pin-error" class="text-red-400 text-sm font-medium opacity-0 transition-opacity duration-200">PIN incorrecto, intenta de nuevo</p>

				<!-- Dots indicator -->
				<div class="flex gap-2" id="pin-dots">
					<span class="w-2.5 h-2.5 rounded-full bg-zinc-700 transition-colors duration-200" data-dot="0"></span>
					<span class="w-2.5 h-2.5 rounded-full bg-zinc-700 transition-colors duration-200" data-dot="1"></span>
					<span class="w-2.5 h-2.5 rounded-full bg-zinc-700 transition-colors duration-200" data-dot="2"></span>
					<span class="w-2.5 h-2.5 rounded-full bg-zinc-700 transition-colors duration-200" data-dot="3"></span>
				</div>
			</div>
		</div>

		<!-- ========== MAIN CONTENT (hidden until unlocked) ========== -->
		<div id="streaming-content" class="opacity-0 pointer-events-none transition-opacity duration-500">

			<!-- Header -->
			<header class="space-y-3 mb-8">
				<p class="text-xs font-semibold uppercase tracking-[0.2em] text-violet-400/80">
					Streaming &middot; {totalServices} Services
				</p>
				<h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
					Streaming Services
				</h1>
				<div class="h-px bg-gradient-to-r from-violet-500/40 via-zinc-700/40 to-transparent"></div>
			</header>

			<!-- Service cards grid -->
			<section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
				{StreamingServiceAccounts.map((service, index) => (
					<article
						class="group relative bg-zinc-800/50 rounded-xl border border-white/6 p-5 hover:border-violet-500/20 hover:bg-zinc-800/70 transition-all duration-300 card-fade-in"
						style={`animation-delay: ${index * 80}ms`}
						data-service={service.name}
					>
						<!-- Top row: Logo + Name + Plan -->
						<div class="flex items-center gap-4 mb-5">
							<div class="flex-shrink-0 w-12 h-12 rounded-lg bg-zinc-900/80 border border-zinc-700/50 flex items-center justify-center p-2 overflow-hidden">
								<img
									src={service.logo}
									alt={`${service.name} logo`}
									class="w-full h-full object-contain"
									loading="lazy"
								/>
							</div>
							<div class="flex-1 min-w-0">
								<h2 class="text-base font-semibold text-white leading-tight truncate">{service.name}</h2>
								{service.plan && (
									<span class="inline-block mt-1 text-[11px] font-medium px-2 py-0.5 rounded-full bg-violet-500/10 text-violet-400 border border-violet-500/20">
										{service.plan}
									</span>
								)}
							</div>
							<!-- External link -->
							<a
								href={service.url}
								target="_blank"
								rel="noopener noreferrer"
								class="flex-shrink-0 text-zinc-500 hover:text-violet-400 transition-colors duration-200"
								title={`Abrir ${service.name}`}
							>
								<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
									<polyline points="15 3 21 3 21 9"></polyline>
									<line x1="10" y1="14" x2="21" y2="3"></line>
								</svg>
							</a>
						</div>

						<!-- Divider -->
						<div class="h-px bg-zinc-700/40 mb-4"></div>

						<!-- Email -->
						<div class="mb-3">
							<label class="text-[11px] font-medium uppercase tracking-wide text-zinc-500 mb-1 block">Email</label>
							<p class="text-sm text-zinc-300 truncate font-mono">{service.email}</p>
						</div>

						<!-- Password -->
						<div>
							<label class="text-[11px] font-medium uppercase tracking-wide text-zinc-500 mb-1 block">Password</label>
							<div class="flex items-center gap-2">
								<div class="flex-1 relative">
									<span class="password-hidden text-sm text-zinc-300 font-mono tracking-wider select-all">
										&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;
									</span>
									<span class="password-visible text-sm text-violet-300 font-mono tracking-wide select-all hidden">
										{service.password}
									</span>
								</div>
								<!-- Toggle visibility -->
								<button
									class="toggle-password flex-shrink-0 p-1.5 rounded-lg text-zinc-500 hover:text-violet-400 hover:bg-violet-500/10 transition-all duration-200"
									title="Mostrar/Ocultar contraseña"
									data-password={service.password}
								>
									<span class="icon-eye-off">
										<IconEyeOff width={16} height={16} />
									</span>
									<span class="icon-eye hidden">
										<IconEye width={16} height={16} />
									</span>
								</button>
								<!-- Copy -->
								<button
									class="copy-password flex-shrink-0 p-1.5 rounded-lg text-zinc-500 hover:text-violet-400 hover:bg-violet-500/10 transition-all duration-200"
									title="Copiar contraseña"
									data-password={service.password}
								>
									<IconCopy width={16} height={16} />
								</button>
							</div>
						</div>

						<!-- Bottom accent bar -->
						<div class="absolute bottom-0 left-5 right-5 h-0.5 bg-gradient-to-r from-violet-500/40 to-transparent rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
					</article>
				))}
			</section>

			<!-- Copy toast notification -->
			<div id="copy-toast" class="fixed bottom-20 left-1/2 -translate-x-1/2 bg-violet-500 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-lg opacity-0 pointer-events-none transition-all duration-300 -translate-y-2 z-50">
				Copiado al portapapeles
			</div>
		</div>
	</main>
</Layout>

<style>
	/* PIN shake animation */
	@keyframes shake {
		0%, 100% { transform: translateX(0); }
		10%, 30%, 50%, 70%, 90% { transform: translateX(-6px); }
		20%, 40%, 60%, 80% { transform: translateX(6px); }
	}
	.pin-shake {
		animation: shake 0.5s ease-in-out;
	}

	/* Card staggered fade-in */
	@keyframes cardFadeIn {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	.card-fade-in {
		opacity: 0;
		animation: cardFadeIn 0.4s ease-out forwards;
		animation-play-state: paused;
	}
	.cards-visible .card-fade-in {
		animation-play-state: running;
	}

	/* PIN input selection highlight */
	.pin-input::selection {
		background: transparent;
	}

	/* PIN success flash */
	@keyframes pinSuccess {
		0% { border-color: rgb(139 92 246); box-shadow: 0 0 0 0 rgb(139 92 246 / 0.4); }
		50% { border-color: rgb(139 92 246); box-shadow: 0 0 12px 2px rgb(139 92 246 / 0.3); }
		100% { border-color: rgb(139 92 246); box-shadow: 0 0 0 0 rgb(139 92 246 / 0); }
	}
	.pin-success {
		animation: pinSuccess 0.6s ease-out;
		border-color: rgb(139 92 246) !important;
	}
</style>

<script>
	document.addEventListener('astro:page-load', () => {
		const PIN_CODE = '1234';

		const pinScreen = document.getElementById('pin-screen');
		const pinContainer = document.getElementById('pin-container');
		const pinError = document.getElementById('pin-error');
		const pinDots = document.getElementById('pin-dots');
		const streamingContent = document.getElementById('streaming-content');
		const copyToast = document.getElementById('copy-toast');

		if (!pinScreen || !pinContainer || !streamingContent) return;

		const pinInputs = pinContainer.querySelectorAll<HTMLInputElement>('.pin-input');
		const dots = pinDots?.querySelectorAll<HTMLElement>('[data-dot]');

		// ---- PIN LOGIC ----
		function getPinValue(): string {
			return Array.from(pinInputs).map(input => input.value).join('');
		}

		function updateDots(): void {
			const filled = getPinValue().length;
			dots?.forEach((dot, i) => {
				if (i < filled) {
					dot.classList.remove('bg-zinc-700');
					dot.classList.add('bg-violet-400');
				} else {
					dot.classList.remove('bg-violet-400');
					dot.classList.add('bg-zinc-700');
				}
			});
		}

		function clearPin(): void {
			pinInputs.forEach(input => {
				input.value = '';
			});
			pinInputs[0]?.focus();
			updateDots();
		}

		function showError(): void {
			if (pinError) pinError.style.opacity = '1';
			pinContainer?.classList.add('pin-shake');
			pinInputs.forEach(input => {
				input.classList.add('border-red-500');
			});

			setTimeout(() => {
				if (pinError) pinError.style.opacity = '0';
				pinContainer?.classList.remove('pin-shake');
				pinInputs.forEach(input => {
					input.classList.remove('border-red-500');
				});
				clearPin();
			}, 1200);
		}

		function unlockContent(): void {
			// Flash success on inputs
			pinInputs.forEach(input => {
				input.classList.add('pin-success');
			});
			dots?.forEach(dot => {
				dot.classList.remove('bg-violet-400');
				dot.classList.add('bg-violet-400');
			});

			setTimeout(() => {
				// Fade out pin screen
				pinScreen!.style.opacity = '0';
				pinScreen!.style.transition = 'opacity 0.4s ease-out';

				setTimeout(() => {
					pinScreen!.style.display = 'none';

					// Show content
					streamingContent!.classList.remove('opacity-0', 'pointer-events-none');
					streamingContent!.classList.add('opacity-100');

					// Trigger card animations
					const grid = streamingContent!.querySelector('section');
					grid?.classList.add('cards-visible');
				}, 400);
			}, 500);
		}

		function checkPin(): void {
			const pin = getPinValue();
			if (pin.length === 4) {
				if (pin === PIN_CODE) {
					unlockContent();
				} else {
					showError();
				}
			}
		}

		// Input event handlers
		pinInputs.forEach((input, index) => {
			input.addEventListener('input', (e) => {
				const target = e.target as HTMLInputElement;
				// Only allow digits
				target.value = target.value.replace(/[^0-9]/g, '');

				if (target.value.length === 1) {
					updateDots();
					if (index < pinInputs.length - 1) {
						pinInputs[index + 1].focus();
					} else {
						// Last digit entered - check PIN
						setTimeout(() => checkPin(), 100);
					}
				}
			});

			input.addEventListener('keydown', (e) => {
				const key = (e as KeyboardEvent).key;
				if (key === 'Backspace') {
					if (input.value === '' && index > 0) {
						pinInputs[index - 1].focus();
						pinInputs[index - 1].value = '';
					} else {
						input.value = '';
					}
					updateDots();
					e.preventDefault();
				} else if (key === 'ArrowLeft' && index > 0) {
					pinInputs[index - 1].focus();
				} else if (key === 'ArrowRight' && index < pinInputs.length - 1) {
					pinInputs[index + 1].focus();
				}
			});

			// Select all on focus for easy overwrite
			input.addEventListener('focus', () => {
				input.select();
			});

			// Handle paste
			input.addEventListener('paste', (e) => {
				e.preventDefault();
				const pasted = (e as ClipboardEvent).clipboardData?.getData('text') || '';
				const digits = pasted.replace(/[^0-9]/g, '').slice(0, 4);
				digits.split('').forEach((digit, i) => {
					if (pinInputs[i]) {
						pinInputs[i].value = digit;
					}
				});
				updateDots();
				if (digits.length === 4) {
					pinInputs[3].focus();
					setTimeout(() => checkPin(), 100);
				} else if (digits.length > 0) {
					pinInputs[Math.min(digits.length, 3)].focus();
				}
			});
		});

		// Focus first input on load
		setTimeout(() => pinInputs[0]?.focus(), 300);

		// ---- PASSWORD TOGGLE ----
		const toggleButtons = document.querySelectorAll('.toggle-password');
		toggleButtons.forEach(btn => {
			btn.addEventListener('click', () => {
				const card = btn.closest('article');
				if (!card) return;

				const hidden = card.querySelector('.password-hidden') as HTMLElement;
				const visible = card.querySelector('.password-visible') as HTMLElement;
				const iconEyeOff = btn.querySelector('.icon-eye-off') as HTMLElement;
				const iconEye = btn.querySelector('.icon-eye') as HTMLElement;

				if (!hidden || !visible || !iconEyeOff || !iconEye) return;

				const isHidden = !hidden.classList.contains('hidden');

				if (isHidden) {
					// Show password
					hidden.classList.add('hidden');
					visible.classList.remove('hidden');
					iconEyeOff.classList.add('hidden');
					iconEye.classList.remove('hidden');
				} else {
					// Hide password
					hidden.classList.remove('hidden');
					visible.classList.add('hidden');
					iconEyeOff.classList.remove('hidden');
					iconEye.classList.add('hidden');
				}
			});
		});

		// ---- COPY PASSWORD ----
		const copyButtons = document.querySelectorAll('.copy-password');
		copyButtons.forEach(btn => {
			btn.addEventListener('click', async () => {
				const password = btn.getAttribute('data-password');
				if (!password) return;

				try {
					await navigator.clipboard.writeText(password);
					showCopyToast();
				} catch {
					// Fallback for older browsers
					const textarea = document.createElement('textarea');
					textarea.value = password;
					textarea.style.position = 'fixed';
					textarea.style.opacity = '0';
					document.body.appendChild(textarea);
					textarea.select();
					document.execCommand('copy');
					document.body.removeChild(textarea);
					showCopyToast();
				}
			});
		});

		function showCopyToast(): void {
			if (!copyToast) return;
			copyToast.classList.remove('opacity-0', '-translate-y-2');
			copyToast.classList.add('opacity-100', 'translate-y-0');

			setTimeout(() => {
				copyToast.classList.remove('opacity-100', 'translate-y-0');
				copyToast.classList.add('opacity-0', '-translate-y-2');
			}, 2000);
		}
	});
</script>
