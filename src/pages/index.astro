---
import Layout from "../layouts/Layout.astro";
import CardDashboard from "../components/Globals/CardDashboard.astro";
import IconDeviceTv from "../components/Icons/IconDeviceTv.astro";
import IconMovie from "../components/Icons/IconMovie.astro";
import IconGamepad from "../components/Icons/IconGamepad.astro";
import IconClapperboard from "../components/Icons/IconClapperboard.astro";
import IconClock from "../components/Icons/IconClock.astro";
import IconTrophy from "../components/Icons/IconTrophy.astro";
import IconStar from "../components/Icons/IconStar.astro";
import IconUser from "../components/Icons/IconUser.astro";
import IconEye from "../components/Icons/IconEye.astro";

import moviesCache from '../data/cache/movies.json';
import seriesCache from '../data/cache/series.json';
import { ListGames } from '../data/gamesDB';

// ─── SERIES STATS ───────────────────────────────────────────
const totalSeasons = seriesCache.series.length;
const uniqueShows = seriesCache.uniqueShows;

const totalEpisodes = (seriesCache.series as any[]).reduce((sum, entry) => {
	const eps = entry.episodes?.length || entry.season?.episode_count || 0;
	return sum + eps;
}, 0);

const totalSeriesMinutes = (seriesCache.series as any[]).reduce((sum, entry) => {
	const eps = entry.episodes?.length || entry.season?.episode_count || 0;
	const runtime = entry.show?.runtime || 0;
	return sum + (eps * runtime);
}, 0);
const totalSeriesHours = Math.round(totalSeriesMinutes / 60);

// ─── MOVIES STATS ───────────────────────────────────────────
const totalMovies = moviesCache.movies.length;
const uniqueMovies = moviesCache.uniqueMovies;

const movieSlugs = new Set<string>();
let totalMoviesMinutes = 0;
let totalMoviesRating = 0;
let ratedMoviesCount = 0;
for (const entry of moviesCache.movies) {
	const slug = (entry as any).movie?.ids?.slug;
	if (slug && !movieSlugs.has(slug)) {
		movieSlugs.add(slug);
		totalMoviesMinutes += (entry as any).movie?.runtime || 0;
		const rating = (entry as any).movie?.rating || 0;
		if (rating > 0) {
			totalMoviesRating += rating;
			ratedMoviesCount++;
		}
	}
}
const totalMoviesHours = Math.round(totalMoviesMinutes / 60);
const avgMovieRating = ratedMoviesCount > 0 ? (totalMoviesRating / ratedMoviesCount).toFixed(1) : '0';

// ─── GAMES STATS ────────────────────────────────────────────
const totalGames = ListGames.length;
const totalGamingHours = ListGames.reduce((sum, g) => sum + (g.horasTotal || 0), 0);
const totalAchievements = ListGames.reduce((sum, g) => sum + (g.logros_obt || 0), 0);
const completedGames = ListGames.filter(g => g.estado === "Completado").length;

// ─── GLOBAL STATS ───────────────────────────────────────────
const totalAllHours = totalSeriesHours + totalMoviesHours + totalGamingHours;
const totalAllItems = uniqueMovies + uniqueShows + totalGames;
const totalAllGenres = new Set([
	...(moviesCache.movies as any[]).flatMap(m => m.movie?.genres || []),
	...(seriesCache.series as any[]).flatMap(s => s.show?.genres || []),
	...ListGames.flatMap(g => g.genre.split(',').map((x: string) => x.trim().toLowerCase())),
]).size;

// ─── VERSION ────────────────────────────────────────────────
const date = new Date();
const formatted =
	date.getFullYear() +
	String(date.getMonth() + 1).padStart(2, '0') +
	String(date.getDate()).padStart(2, '0') +
	'.' +
	String(date.getHours()).padStart(2, '0') +
	String(date.getMinutes()).padStart(2, '0');
---

<Layout>
	<main class="max-w-7xl w-full mx-auto p-4 pb-24 space-y-6">

		<!-- ═══════════════════════════════════════════════════════ -->
		<!-- HEADER CON PERFIL                                      -->
		<!-- ═══════════════════════════════════════════════════════ -->
		<header class="relative">
			<div class="flex items-center justify-between gap-4">
				<div class="flex items-center gap-3.5">
					<!-- Avatar -->
					<a
						href="https://trakt.tv/users/auferoz"
						target="_blank"
						rel="noopener noreferrer"
						class="shrink-0 w-11 h-11 rounded-full bg-neutral-500/15 border border-neutral-500/25 flex items-center justify-center text-neutral-400 font-bold text-lg hover:bg-neutral-500/25 hover:border-neutral-500/40 transition-all duration-200"
						title="Ver perfil en Trakt"
					>
						A
					</a>
					<div>
						<p class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-400/80 mb-0.5">Auferoz</p>
						<h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white leading-none">
							Dashboard
						</h1>
					</div>
				</div>
				<span class="text-[10px] text-zinc-600 tabular-nums font-medium shrink-0">v0.0{formatted}</span>
			</div>

			<p class="text-sm text-zinc-500 mt-3">
				<span class="text-slate-400/70">{totalAllItems} items</span>
				<span class="text-zinc-600">&middot;</span>
				<span class="text-green-400/70">{totalAllHours}h de entretenimiento</span>
				<span class="text-zinc-600">&middot;</span>
				<span class="text-amber-400/70">{totalAllGenres} generos</span>
			</p>

			<div class="mt-4 h-px bg-linear-to-r from-neutral-500/40 via-zinc-700/40 to-transparent"></div>
		</header>

		<!-- ═══════════════════════════════════════════════════════ -->
		<!-- GLOBAL SUMMARY                                         -->
		<!-- ═══════════════════════════════════════════════════════ -->
		<section>
			<p class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-400/80 mb-3">Resumen Global</p>
			<div class="grid grid-cols-2 xl:grid-cols-4 gap-2 sm:gap-3">
				<CardDashboard text="Total Items" number={totalAllItems} color="neutral">
					<IconEye width={20} height={20} />
				</CardDashboard>
				<CardDashboard text="Horas Totales" number={`${totalAllHours}h`} color="neutral">
					<IconClock width={20} height={20} />
				</CardDashboard>
				<CardDashboard text="Shows Unicos" number={uniqueShows} color="neutral">
					<IconDeviceTv width={20} height={20} />
				</CardDashboard>
				<CardDashboard text="Peliculas Unicas" number={uniqueMovies} color="neutral">
					<IconMovie width={20} height={20} />
				</CardDashboard>
			</div>
		</section>

		<!-- ═══════════════════════════════════════════════════════ -->
		<!-- SERIES                                                  -->
		<!-- ═══════════════════════════════════════════════════════ -->
		<section>
			<div class="h-px bg-linear-to-r from-sky-500/40 via-zinc-700/40 to-transparent mb-4"></div>
			<p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-400/80 mb-3">Series</p>
			<div class="grid grid-cols-2 xl:grid-cols-4 gap-2 sm:gap-3">
				<CardDashboard text="Temporadas" number={totalSeasons} color="sky">
					<IconDeviceTv width={20} height={20} />
				</CardDashboard>
				<CardDashboard text="Episodios" number={totalEpisodes} color="sky">
					<IconClapperboard width={20} height={20} />
				</CardDashboard>
				<CardDashboard text="Horas Series" number={`${totalSeriesHours}h`} color="sky">
					<IconClock width={20} height={20} />
				</CardDashboard>
				<CardDashboard text="Shows Unicos" number={uniqueShows} color="sky">
					<IconStar width={20} height={20} />
				</CardDashboard>
			</div>
		</section>

		<!-- ═══════════════════════════════════════════════════════ -->
		<!-- MOVIES                                                  -->
		<!-- ═══════════════════════════════════════════════════════ -->
		<section>
			<div class="h-px bg-linear-to-r from-indigo-500/40 via-zinc-700/40 to-transparent mb-4"></div>
			<p class="text-xs font-semibold uppercase tracking-[0.2em] text-indigo-400/80 mb-3">Peliculas</p>
			<div class="grid grid-cols-2 xl:grid-cols-4 gap-2 sm:gap-3">
				<CardDashboard text="Total Peliculas" number={totalMovies} color="indigo">
					<IconMovie width={20} height={20} />
				</CardDashboard>
				<CardDashboard text="Peliculas Unicas" number={uniqueMovies} color="indigo">
					<IconEye width={20} height={20} />
				</CardDashboard>
				<CardDashboard text="Horas Movies" number={`${totalMoviesHours}h`} color="indigo">
					<IconClock width={20} height={20} />
				</CardDashboard>
				<CardDashboard text="Rating Promedio" number={avgMovieRating} color="indigo">
					<IconStar width={20} height={20} />
				</CardDashboard>
			</div>
		</section>

		<!-- ═══════════════════════════════════════════════════════ -->
		<!-- GAMES                                                   -->
		<!-- ═══════════════════════════════════════════════════════ -->
		<section>
			<div class="h-px bg-linear-to-r from-teal-500/40 via-zinc-700/40 to-transparent mb-4"></div>
			<p class="text-xs font-semibold uppercase tracking-[0.2em] text-teal-400/80 mb-3">Videojuegos</p>
			<div class="grid grid-cols-2 xl:grid-cols-4 gap-2 sm:gap-3">
				<CardDashboard text="Total Juegos" number={totalGames} color="teal">
					<IconGamepad width={20} height={20} />
				</CardDashboard>
				<CardDashboard text="Horas Gaming" number={`${totalGamingHours}h`} color="teal">
					<IconClock width={20} height={20} />
				</CardDashboard>
				<CardDashboard text="Logros" number={totalAchievements} color="teal">
					<IconTrophy width={20} height={20} />
				</CardDashboard>
				<CardDashboard text="Completados" number={completedGames} color="green">
					<IconTrophy width={20} height={20} />
				</CardDashboard>
			</div>
		</section>

		<!-- ═══════════════════════════════════════════════════════ -->
		<!-- Streaming                                               -->
		<!-- ═══════════════════════════════════════════════════════ -->

		<section>
			<div class="h-px bg-linear-to-r from-stone-500/40 via-zinc-700/40 to-transparent mb-4"></div>
			<p class="text-xs font-semibold uppercase tracking-[0.2em] text-stone-400/80 mb-3">Streaming</p>
			<div class="grid grid-cols-2 xl:grid-cols-4 gap-2 sm:gap-3">
				<CardDashboard text="Total Streamings" number="7" color="stone">
					<a href="/streaming">
						<IconEye width={20} height={20} />
					</a>
				</CardDashboard>
			</div>
		</section>

	</main>
</Layout>
